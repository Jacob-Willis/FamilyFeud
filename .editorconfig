# House style for the FamilyFeud app. Severities stay at suggestion/silent so style never breaks the build.
root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
# Line endings are left to git (.gitattributes: text=auto). Files keep their existing BOM/no-BOM.

[*.{csproj,props,targets,xml,xaml,json,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Explicit types instead of var (var is still needed for anonymous types)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Block-scoped namespaces (namespace X { ... }), usings outside the namespace, System usings not forced first
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false

# Allman braces: every opening brace on its own line
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false

# Single-line guard clauses such as "if (x) return;" are part of the style
csharp_prefer_braces = when_multiline:silent
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true

# Expression-bodied members: allowed for one-liners, not required
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_constructors = false:silent

# Newer syntax the code base doesn't use consistently: allowed, not suggested
# (target-typed new, collection expressions, primary constructors, using declarations, object initializers)
csharp_style_implicit_object_creation_when_type_is_apparent = true:silent
dotnet_style_prefer_collection_expression = when_types_loosely_match:silent
dotnet_style_collection_initializer = true:silent
dotnet_style_object_initializer = true:silent
csharp_style_prefer_primary_constructors = true:silent
csharp_prefer_simple_using_statement = true:silent
csharp_style_prefer_null_check_over_type_check = true:silent
csharp_style_throw_expression = true:silent
dotnet_style_coalesce_expression = true:silent
dotnet_style_namespace_match_folder = true:silent

# Language keywords (string, int) instead of framework names (String, Int32)
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# No "this." qualification
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Naming: PascalCase types, members and constants; _camelCase private fields
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, property, method, event, delegate
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_rule.types_and_members_pascal.severity = suggestion

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = suggestion

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
