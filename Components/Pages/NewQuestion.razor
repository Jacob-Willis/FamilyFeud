@page "/new-question"
@page "/new-question/{QuestionId:int}"

@* Delete confirmation (#17). In-page modal because browser confirm() isn't reliable in BlazorWebView. *@
@if (_showDeleteConfirm)
{
    <div class="ff-modal-backdrop">
        <div class="ff-modal ff-delete-modal">
            <h4>Delete question?</h4>
            <p class="mb-1">&ldquo;@_questionText&rdquo;</p>
            <p class="text-muted small">This deletes the question and all of its saved answers. It can't be undone.</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="alert alert-danger py-2">@_deleteError</div>
            }
            <div class="ff-btn-row ff-modal-actions">
                <button type="button" class="ff-btn" @onclick="CancelDelete" disabled="@_isDeleting">Cancel</button>
                <button type="button" class="ff-btn ff-btn-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">@(_isDeleting ? "Deleting..." : "Delete")</button>
            </div>
        </div>
    </div>
}

<div class="ff-page-header">
    <button class="ff-btn" @onclick="GoBack">Back</button>
</div>

<div class="ff-container">
    @if (_isLoading)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-4 text-muted">@(_isEditing ? "Loading question..." : "Creating question...")</p>
            </div>
        </div>
    }

    <form @onsubmit="HandleSubmit" class="@(_isLoading ? "d-none" : "") ff-form-container">
        <div class="ff-container-border">

            <div>
                <label for="questionText" class="form-label ff-form-label">Question Text</label>
                <input type="text" class="form-control ff-form-input" id="questionText" @bind="_questionText" required />
            </div>

            <div>
                <label for="category" class="form-label ff-form-label">Category</label>
                @* ComboBox, not <datalist>: WKWebView on Mac Catalyst doesn't show datalist suggestions (#64).
                   m-2 gives it the 0.5rem margins of .ff-form-input, so it lines up with the other inputs. *@
                <div class="m-2">
                    <ComboBox Id="category" @bind-Value="_category" Options="_categories" Placeholder="Select or type a category" InputClass="form-control" />
                </div>
            </div>

            <div>
                <label class="form-label ff-form-label">Answers</label>
                <table class="ff-answers-table">
                    <thead>
                        <tr>
                            <th>Answer</th>
                            <th>Points</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _answers.Count; i++)
                        {
                            int index = i;
                            <tr>
                                <td>
                                    <input type="text" class="form-control ff-form-input table-text" placeholder="Answer text" @bind="_answers[index].AnswerText" required />
                                </td>
                                <td>
                                    <input type="number" class="form-control ff-form-input table-number"
                                           placeholder="0"
                                           min="1"
                                           value="@_answers[index].Points"
                                           @onchange="async (ChangeEventArgs e) => await OnAnswerPointsChanged(index, e)"
                                           required />
                                </td>
                                <td>
                                    <button type="button" class="ff-btn ff-btn-sm" @onclick="() => RemoveAnswer(index)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-center mt-3">
                    <button type="button" class="ff-btn" @onclick="AddAnswer" disabled="@(_answers.Count >= 6)">+ Add Answer</button>
                </div>
            </div>

            <div class="ff-btn-row ff-form-actions">
                <button type="submit" class="ff-btn ff-btn-primary" disabled="@_isLoading">@(_isEditing ? "Update Question" : "Create Question")</button>
                <button type="button" class="ff-btn" @onclick="GoBack" disabled="@_isLoading">Cancel</button>
                @if (_isEditing && _questionLoaded)
                {
                    <button type="button" class="ff-btn ff-btn-danger" @onclick="AskDelete" disabled="@_isLoading">Delete</button>
                }
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert @(_isSuccess ? "alert-success" : "alert-danger") mt-3">@_message</div>
            }
        </div>
    </form>
</div>
