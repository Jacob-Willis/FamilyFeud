@page "/game"
@using FamilyFeud.Services
@using FamilyFeud.Services.Hasura

<div class="ff-page-header">
    <button class="ff-back-button" @onclick="GoBack" disabled="@(IsChoiceModalOpen)">Back</button>
</div>

@* Blocking Play/Pass modal after the face-off. Its backdrop covers the page and Back is disabled while it is open. *@
@if (GameState.PlayoffAwaitingChoice && GameState.WhichTeamsTurn != SelectedTeam.Random)
{
    <div class="ff-modal-backdrop">
        <div class="ff-modal">
            <h4>Play or Pass</h4>
            <p>@(GameState.WhichTeamsTurn == SelectedTeam.Team1 ? GameState.Team1.Name : GameState.Team2.Name) to select either:</p>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="() => GameState.ChoosePlay()">Play</button>
                <button class="btn btn-secondary" @onclick="() => GameState.ChoosePass()">Pass</button>
            </div>
        </div>
    </div>
}

@* Confirmation before abandoning or spoiling a round in progress (#13) *@
@if (PendingConfirm != ConfirmAction.None)
{
    <div class="ff-modal-backdrop">
        <div class="ff-modal">
            <h4>@(PendingConfirm == ConfirmAction.LoadQuestion ? "Load a new question?" : "Reveal all answers?")</h4>
            <p>@(PendingConfirm == ConfirmAction.LoadQuestion
                ? "This round is still in progress. Loading a new question abandons it and the round pool is lost."
                : "This round is still in progress. Revealing all answers shows them to the audience before the round is played out.")</p>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="ConfirmPendingAction">@(PendingConfirm == ConfirmAction.LoadQuestion ? "Load Question" : "Reveal All Answers")</button>
                <button class="btn btn-secondary" @onclick="CancelPendingAction">Cancel</button>
            </div>
        </div>
    </div>
}

@* Winning screen (#8): shown above the board once the game is over; the last round's answers stay visible below *@
@if (GameState.IsGameOver)
{
    <div class="ff-container ff-container-border ff-winner">
        <p class="ff-winner-label mb-0">Game over</p>
        <h2 class="ff-winner-headline mb-0">@GameState.WinnerHeadline</h2>
        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <div class="ff-winner-team @(GameState.Winner == SelectedTeam.Team1 ? "winner" : "")">
                <span class="ff-winner-team-name">@GameState.Team1.Name</span>
                <span class="ff-winner-team-score">@GameState.Team1.Score</span>
            </div>
            <div class="ff-winner-team @(GameState.Winner == SelectedTeam.Team2 ? "winner" : "")">
                <span class="ff-winner-team-name">@GameState.Team2.Name</span>
                <span class="ff-winner-team-score">@GameState.Team2.Score</span>
            </div>
        </div>
        <p class="ff-muted-small mb-0">@GameState.GameOverReasonText</p>
        <button class="ff-start-game-button align-self-center" @onclick="GoBack">New game</button>
    </div>
}

<div class="ff-container ff-container-border">
    <div class="Teams">
        <h3 class="ff-muted">Teams</h3>
        <div class="d-flex gap-5">
            <div class="ff-team-summary @(GameState.WhichTeamsTurn == SelectedTeam.Team1 ? "selected" : "")">
                <strong>@GameState.Team1.Name</strong>
                <div>Score: @GameState.Team1.Score</div>
            </div>
            <div class="ff-team-summary @(GameState.WhichTeamsTurn == SelectedTeam.Team2 ? "selected" : "")">
                <strong>@GameState.Team2.Name</strong>
                <div>Score: @GameState.Team2.Score</div>
            </div>
        </div>
        <p class="ff-muted mt-3 mb-0">Round pool: @GameState.RoundPool</p>
        <p class="ff-muted-small mb-0">@GameProgressText</p>
    </div>
    @if (CurrentQuestion != null)
    {
        <div class="ff-question">
            <p class="ff-muted">Question:</p>
            <p class="ff-muted-small">@CurrentQuestion.QuestionText</p>
        </div>
    }
    @if (GameState.Mode == GameMode.PointSteal)
    {
        <div class="ff-muted-small">Steal attempt in progress. Reveal answer for stealing team or click Strike to fail.</div>
    }
    @if (!string.IsNullOrEmpty(InfoMessage))
    {
        <div class="alert alert-info py-2 mb-0" role="status">@InfoMessage</div>
    }
    @* Loading questions from Hasura failed: show why and let the host try again (#15) *@
    @if (GameState.IsLoading)
    {
        <div class="d-flex align-items-center gap-2 ff-muted-small" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading questions...</span>
        </div>
    }
    else if (HasLoadError)
    {
        <div class="alert alert-danger py-2 mb-0 d-flex align-items-center gap-3" role="alert">
            <span class="me-auto">Couldn't load the questions: @GameState.ErrorMessage</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="RetryLoadQuestions">Retry</button>
        </div>
    }
</div>

@if (CurrentQuestion != null)
{
    <div class="ff-container ff-container-border">
        <p class="ff-muted">Answers</p>
        <div class="ff-answer-box">
            @foreach (Answer a in CurrentQuestion.Answers)
            {
                bool isRevealed = GameState.IsAnswerRevealed(CurrentQuestion.Id, a.Id);
                <button @key="@(CurrentQuestion.Id + "-" + a.Id)" class="ff-answer-item @(isRevealed ? "revealed" : "")" disabled="@(IsChoiceModalOpen || GameState.IsRoundFinished || isRevealed)" title="@(isRevealed ? "Already revealed" : null)" @onclick="() => { if (!IsChoiceModalOpen && !GameState.IsRoundFinished && !isRevealed) RevealAnswer(a); }">
                    @if (isRevealed)
                    {
                        <span class="revealed-badge">Revealed</span>
                    }
                    <div class="answer-text">@a.AnswerText</div>
                    <div class="answer-points">@a.Points</div>
                </button>
            }
        </div>
    </div>
}

<div class="ff-page-footer fixed-bottom">
    <div class="d-flex gap-2 align-items-center w-100">
        <div class="d-flex align-items-center">
            <span class="me-2">Remaining questions in category:</span>
            <span>@QuestionsInSelectedCategory().Count</span>
        </div>
        <div class="me-auto">
            <select class="form-select" style="min-width:200px;" @bind="SelectedCategory" disabled="@(IsChoiceModalOpen || GameState.IsGameOver)">
                @foreach (string c in Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <button class="btn ff-button" disabled="@(GameState.IsGameOver || GameState.IsLoading)" @onclick="RequestLoadQuestion">Load Question</button>
        <button class="btn ff-button" @onclick="() => { if (!IsChoiceModalOpen) OpenGameWindow(); }">@(IsAudienceOpen ? "Close game window" : "Open game window")</button>
        <button class="btn ff-button" @onclick="RequestRevealAll">Reveal All Answers</button>
        <button class="btn ff-button" disabled="@(!CanStrike)" @onclick="() => { if (CanStrike) GameState.HostStrike(); }">Strike</button>
        <span class="ff-muted">Strikes:</span><span class="ff-muted-small"> @((GameState.WhichTeamsTurn == SelectedTeam.Team1) ? ($"{GameState.Team1.IncorrectStrikes} /3") : ($"{GameState.Team2.IncorrectStrikes} /3"))</span>
    </div>
</div>
