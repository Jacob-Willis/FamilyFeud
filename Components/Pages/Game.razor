@page "/game"
@using FamilyFeud.Services
@using FamilyFeud.Services.Hasura

<div class="ff-page-header">
    <button class="ff-btn" @onclick="GoBack" disabled="@(IsChoiceModalOpen)">Back</button>
</div>

@* Narrow windows only: pushes the first panel below the fixed Back button *@
<div class="ff-header-spacer" aria-hidden="true"></div>

@* Blocking Play/Pass modal after the face-off. Its backdrop covers the page and Back is disabled while it is open. *@
@if (GameState.PlayoffAwaitingChoice && GameState.WhichTeamsTurn != SelectedTeam.Random)
{
    <div class="ff-modal-backdrop">
        <div class="ff-modal">
            <h4>Play or Pass</h4>
            <p>@(GameState.WhichTeamsTurn == SelectedTeam.Team1 ? GameState.Team1.Name : GameState.Team2.Name) to select either:</p>
            <div class="ff-btn-row ff-modal-actions">
                <button class="ff-btn ff-btn-primary" @onclick="() => GameState.ChoosePlay()">Play</button>
                <button class="ff-btn" @onclick="() => GameState.ChoosePass()">Pass</button>
            </div>
        </div>
    </div>
}

@* Confirmation before abandoning or spoiling a round in progress (#13) *@
@if (PendingConfirm != ConfirmAction.None)
{
    <div class="ff-modal-backdrop">
        <div class="ff-modal">
            <h4>@(PendingConfirm == ConfirmAction.LoadQuestion ? "Load a new question?" : "Reveal all answers?")</h4>
            <p>@(PendingConfirm == ConfirmAction.LoadQuestion
                ? "This round is still in progress. Loading a new question abandons it and the round pool is lost."
                : "This round is still in progress. Revealing all answers shows them to the audience before the round is played out.")</p>
            <div class="ff-btn-row ff-modal-actions">
                <button class="ff-btn" @onclick="CancelPendingAction">Cancel</button>
                <button class="ff-btn ff-btn-primary" @onclick="ConfirmPendingAction">@(PendingConfirm == ConfirmAction.LoadQuestion ? "Load Question" : "Reveal All Answers")</button>
            </div>
        </div>
    </div>
}

@* Host-only question picker (#38): lists the remaining questions in the picker's own category (#44), which starts as
   the footer's category but doesn't change it. The audience window mounts Audience.razor, not this page, so it never
   sees this list. *@
@if (IsPickerOpen)
{
    List<Question> picks = PickerQuestions();
    int inCategory = PickerQuestionsInCategory().Count;
    <div class="ff-modal-backdrop">
        <div class="ff-modal ff-picker">
            <h4>Choose question</h4>
            <div class="d-flex gap-2 mb-2">
                <select class="ff-select" aria-label="Picker category" @bind="PickerCategory">
                    <option value="@AllCategories">@CategoryLabel(AllCategories)</option>
                    @foreach (string c in Categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
                <input class="ff-input flex-grow-1" type="search" placeholder="Search questions or categories" aria-label="Search questions or categories" @bind="PickerSearch" @bind:event="oninput" />
            </div>
            <p class="ff-picker-count mb-2">@picks.Count @(picks.Count == 1 ? "question" : "questions")</p>
            @if (picks.Count == 0)
            {
                <p class="ff-picker-empty mb-2">@(inCategory == 0
                    ? $"No questions left in {CategoryLabel(PickerCategory)} — choose another category."
                    : $"No questions in {CategoryLabel(PickerCategory)} match your search.")</p>
            }
            else
            {
                <div class="ff-picker-list mb-2">
                    @foreach (Question q in picks)
                    {
                        <button @key="q.Id" type="button" class="ff-picker-item" @onclick="() => PickQuestion(q)">
                            <span>@q.QuestionText</span>
                            @if (IsAllCategories(PickerCategory) && !string.IsNullOrWhiteSpace(q.Category))
                            {
                                <span class="ff-picker-category ms-2">@q.Category</span>
                            }
                        </button>
                    }
                </div>
            }
            <div class="ff-btn-row ff-modal-actions">
                <button class="ff-btn" @onclick="CloseQuestionPicker">Cancel</button>
            </div>
        </div>
    </div>
}

@* Winning screen (#8): shown above the board once the game is over; the last round's answers stay visible below *@
@if (GameState.IsGameOver)
{
    <div class="ff-container ff-container-border ff-winner">
        <p class="ff-winner-label mb-0">Game over</p>
        <h2 class="ff-winner-headline mb-0">@GameState.WinnerHeadline</h2>
        <div class="d-flex justify-content-center gap-4 flex-wrap">
            <div class="ff-winner-team @(GameState.Winner == SelectedTeam.Team1 ? "winner" : "")">
                <span class="ff-winner-team-name">@GameState.Team1.Name</span>
                <span class="ff-winner-team-score">@GameState.Team1.Score</span>
            </div>
            <div class="ff-winner-team @(GameState.Winner == SelectedTeam.Team2 ? "winner" : "")">
                <span class="ff-winner-team-name">@GameState.Team2.Name</span>
                <span class="ff-winner-team-score">@GameState.Team2.Score</span>
            </div>
        </div>
        <p class="ff-muted-small mb-0">@GameState.GameOverReasonText</p>
        <button class="ff-btn ff-btn-primary align-self-center" @onclick="GoBack">New game</button>
    </div>
}

<div class="ff-container ff-container-border">
    @* Panel headings (#56) have no margin of their own: the panel's flex gap is the only space below them *@
    <h3 class="ff-muted mb-0">Teams</h3>
    <div class="Teams">
        <div class="d-flex gap-5">
            <div class="ff-team-summary @(GameState.WhichTeamsTurn == SelectedTeam.Team1 ? "selected" : "")">
                <strong>@GameState.Team1.Name</strong>
                <div>Score: @GameState.Team1.Score</div>
            </div>
            <div class="ff-team-summary @(GameState.WhichTeamsTurn == SelectedTeam.Team2 ? "selected" : "")">
                <strong>@GameState.Team2.Name</strong>
                <div>Score: @GameState.Team2.Score</div>
            </div>
        </div>
        <p class="ff-muted mt-3 mb-0">Round pool: @GameState.RoundPool</p>
        <p class="ff-muted-small mb-0">@GameProgressText</p>
    </div>
    @if (CurrentQuestion != null)
    {
        <div class="ff-question">
            <p class="ff-muted mb-0">Question:</p>
            <p class="ff-muted-small mb-0">@CurrentQuestion.QuestionText</p>
        </div>
    }
    @* Mode stays PointSteal after the round ends, so also check IsRoundFinished (#40) *@
    @if (GameState.Mode == GameMode.PointSteal && !GameState.IsRoundFinished)
    {
        <div class="ff-muted-small mb-0">Steal attempt in progress. Reveal answer for stealing team or click Strike to fail.</div>
    }
    @if (!string.IsNullOrEmpty(InfoMessage))
    {
        <div class="alert alert-info py-2 mb-0" role="status">@InfoMessage</div>
    }
    @* Loading questions from Hasura failed: show why and let the host try again (#15) *@
    @if (GameState.IsLoading)
    {
        <div class="d-flex align-items-center gap-2 ff-muted-small mb-0" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading questions...</span>
        </div>
    }
    else if (HasLoadError)
    {
        <div class="alert alert-danger py-2 mb-0 d-flex align-items-center gap-3" role="alert">
            <span class="me-auto">Couldn't load the questions: @GameState.ErrorMessage</span>
            <button class="ff-btn ff-btn-sm" @onclick="RetryLoadQuestions">Retry</button>
        </div>
    }
    else if (NoQuestionsFound)
    {
        @* The load worked but there are no questions to play (#33) *@
        <div class="alert alert-info py-2 mb-0 d-flex align-items-center gap-3" role="status">
            <span class="me-auto">No questions found — add some on the Questions page.</span>
            <button class="ff-btn ff-btn-sm" @onclick="GoToQuestions">Go to Questions</button>
        </div>
    }
</div>

@if (CurrentQuestion != null)
{
    <div class="ff-container ff-container-border">
        <p class="ff-muted mb-0">Answers</p>
        <div class="ff-answer-box">
            @foreach (Answer a in CurrentQuestion.Answers)
            {
                bool isRevealed = GameState.IsAnswerRevealed(CurrentQuestion.Id, a.Id);
                <button @key="@(CurrentQuestion.Id + "-" + a.Id)" class="ff-answer-item @(isRevealed ? "revealed" : "")" disabled="@(IsChoiceModalOpen || GameState.IsRoundFinished || isRevealed)" title="@(isRevealed ? "Already revealed" : null)" @onclick="() => { if (!IsChoiceModalOpen && !GameState.IsRoundFinished && !isRevealed) RevealAnswer(a); }">
                    @if (isRevealed)
                    {
                        <span class="revealed-badge">Revealed</span>
                    }
                    <div class="answer-text">@a.AnswerText</div>
                    <div class="answer-points">@a.Points</div>
                </button>
            }
        </div>
    </div>
}

@* Keeps the bottom of the board scrollable above the fixed footer *@
<div class="ff-footer-spacer" aria-hidden="true"></div>

<div class="ff-page-footer fixed-bottom">
    <div class="ff-btn-row flex-xl-nowrap w-100">
        <div class="d-flex align-items-center">
            <span class="me-2">Remaining questions in category:</span>
            <span>@QuestionsInSelectedCategory().Count</span>
        </div>
        <div class="me-auto">
            <select class="ff-select ff-footer-select" @bind="SelectedCategory" disabled="@(IsChoiceModalOpen || GameState.IsGameOver)">
                <option value="@AllCategories">@CategoryLabel(AllCategories)</option>
                @foreach (string c in Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <button class="ff-btn" disabled="@(GameState.IsGameOver || GameState.IsLoading)" @onclick="() => RequestLoadQuestion()">Load Question</button>
        <button class="ff-btn" disabled="@(GameState.IsGameOver || GameState.IsLoading || NoQuestionsFound || HasLoadError)" title="Pick the next question from the remaining questions" @onclick="OpenQuestionPicker">Choose question…</button>
        <button class="ff-btn" @onclick="() => { if (!IsChoiceModalOpen) OpenGameWindow(); }">@(IsAudienceOpen ? "Close game window" : "Open game window")</button>
        <button class="ff-btn" @onclick="RequestRevealAll">Reveal All Answers</button>
        <button class="ff-btn" disabled="@(!CanStrike)" @onclick="() => { if (CanStrike) GameState.HostStrike(); }">Strike</button>
        <div class="ff-footer-strikes">
            <span class="ff-muted mb-0">Strikes:</span>
            <span class="ff-muted-small mb-0">@((GameState.WhichTeamsTurn == SelectedTeam.Team1) ? ($"{GameState.Team1.IncorrectStrikes} /3") : ($"{GameState.Team2.IncorrectStrikes} /3"))</span>
        </div>
    </div>
</div>
