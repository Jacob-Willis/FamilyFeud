@page "/questions"
@using FamilyFeud.Services.Hasura

@* Delete confirmation (#17). In-page modal because browser confirm() isn't reliable in BlazorWebView. *@
@if (_pendingDelete != null)
{
    <div class="ff-modal-backdrop">
        <div class="ff-modal ff-delete-modal">
            <h4>Delete question?</h4>
            <p class="mb-1">&ldquo;@_pendingDelete.QuestionText&rdquo;</p>
            <p class="text-muted small">This deletes the question and its @_pendingDelete.Answers.Count answer(s). It can't be undone.</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="alert alert-danger py-2">@_deleteError</div>
            }
            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="ff-modal-button ff-modal-button-cancel" @onclick="CancelDelete" disabled="@_isDeleting">Cancel</button>
                <button type="button" class="ff-modal-button ff-modal-button-danger" @onclick="ConfirmDelete" disabled="@_isDeleting">@(_isDeleting ? "Deleting..." : "Delete")</button>
            </div>
        </div>
    </div>
}

<div class="ff-page-header">
    <button class="ff-back-button" @onclick="GoBack">Back</button>
</div>

<div class="ff-container">
    <div class="ff-container ff-question-search">
        <input type="text" placeholder="Search questions..." @bind="_searchText" class="ff-search-input" />
        <select @bind="_selectedCategory" class="ff-category-select">
            <option value="">All Categories</option>
            @foreach (string category in GetUniqueCategories())
            {
                <option value="@category">@category</option>
            }
        </select>
        <button class="ff-search-action-button" @onclick="NewQuestion">New Question</button>
    </div>
    <div class="ff-questions-list">
        @if (IsLoading)
        {
            <div class="text-muted">Loading questions...</div>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }
        else if (AllQuestions?.Count == 0)
        {
            <div class="text-muted">No questions found.</div>
        }
        else
        {
            <div>
                @foreach (Question q in GetFilteredQuestions())
                {
                    <div class="ff-answer-container">
                        <div class="ff-answer-container-heading">
                            <h5 class="ff-muted">@q.QuestionText</h5>
                            <small class="ff-muted-small">@q.Category</small>
                            <div class="d-flex gap-2 align-items-start">
                                <button class="ff-button-secondary ff-button-sm" @onclick="() => EditQuestion(q.Id)">Edit</button>
                                <button class="ff-button-danger ff-button-sm" @onclick="() => AskDelete(q)">Delete</button>
                            </div>
                        </div>
                        <ul class="ff-answer-container-answers mb-0">
                            @foreach (Answer a in q.Answers.OrderByDescending(a => a.Points))
                            {
                                <li>
                                    <span class="ff-answer-container-points">@a.Points</span>
                                    <span class="ff-answer-container-answer">@a.AnswerText</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>
</div>
