@page "/startgame"
@using FamilyFeud.Services

<div class="ff-page-header">
    <button class="ff-back-button" @onclick="GoBack">Back</button>
</div>

<div class="ff-container">
    <div class="ff-teams-container">
        <!-- Team 1 -->
        <div class="ff-team-box ff-team1">
            <input class="form-control mb-2 text-center" @bind="Team1Name" />
            <div class="ff-team-color" aria-hidden="true"></div>
        </div>

        <!-- Team 2 -->
        <div class="ff-team-box ff-team2">
            <input class="form-control mb-2 text-center" @bind="Team2Name" />
            <div class="ff-team-color" aria-hidden="true"></div>
        </div>
    </div>

    <div class="ff-first-picker">
        <p class="ff-muted">Who goes first?</p>

        <InputRadioGroup TValue="SelectedTeam" @bind-Value="SelectedFirst">
            <div>
                <label class="ff-first-option">
                    <InputRadio class="ff-radio-hidden"
                                TValue="SelectedTeam"
                                Value="@SelectedTeam.Team1" />
                    <span class="ff-option-content">
                        <span class="ff-option-icon">🏆</span>
                        @Team1Name
                    </span>
                </label>

                <label class="ff-first-option">
                    <InputRadio class="ff-radio-hidden"
                                TValue="SelectedTeam"
                                Value="@SelectedTeam.Random" />
                    <span class="ff-option-content">
                        <span class="ff-option-icon">🎲</span>
                        Random
                    </span>
                </label>

                <label class="ff-first-option">
                    <InputRadio class="ff-radio-hidden"
                                TValue="SelectedTeam"
                                Value="@SelectedTeam.Team2" />
                    <span class="ff-option-content">
                        <span class="ff-option-icon">⚡</span>
                        @Team2Name
                    </span>
                </label>
            </div>
        </InputRadioGroup>

        <p class="ff-muted mb-0">Game length</p>
        <div class="ff-length-picker">
            <label class="ff-first-option">
                <input type="radio" class="ff-radio-hidden" name="ff-game-length"
                       checked="@(LengthMode == GameLengthMode.Rounds)"
                       @onchange="() => LengthMode = GameLengthMode.Rounds" />
                <span class="ff-option-content">Number of rounds</span>
            </label>
            <select class="form-select w-auto" aria-label="Number of rounds" @bind="TotalRounds"
                    disabled="@(LengthMode != GameLengthMode.Rounds)">
                @foreach (int option in GameStateService.RoundOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
        <div class="ff-length-picker">
            <label class="ff-first-option">
                <input type="radio" class="ff-radio-hidden" name="ff-game-length"
                       checked="@(LengthMode == GameLengthMode.TargetScore)"
                       @onchange="() => LengthMode = GameLengthMode.TargetScore" />
                <span class="ff-option-content">Target score</span>
            </label>
            <input type="number" class="form-control w-auto" aria-label="Target score" min="1" max="@MaxTargetScore" step="50"
                   @bind="TargetScore" disabled="@(LengthMode != GameLengthMode.TargetScore)" />
            <span class="ff-muted-small">points</span>
        </div>
        @if (!IsTargetScoreValid)
        {
            <p class="text-danger mb-0">Target score must be a whole number from 1 to @MaxTargetScore.</p>
        }

        <button class="ff-start-game-button" @onclick="PlayGame" disabled="@VerifyStart">Start</button>
    </div>
</div>
