<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:FamilyFeud.Components.Pages"
             x:Class="FamilyFeud.Components.Pages.AudiencePage"
             BackgroundColor="#0B0D1A">

    <BlazorWebView HostPage="wwwroot/index.html" BackgroundColor="#0B0D1A">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Audience}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
